---
import PostList from "../../components/PostList.astro";
import Layout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../utils/posts";

const posts = getPosts();
---

<Layout
  title="Posts — Brian Hennessy"
  description="Posts by Brian Hennessy on technology, infrastructure, and the things he is learning."
>
  <section class="animate-in mt-16">
    <div class="flex flex-col gap-8">
      <div class="space-y-3">
        <h1 class="text-3xl font-semibold tracking-tight">Posts</h1>
        <p class="text-secondary max-w-lg">
          Posts on technology, infrastructure, and the things I am learning
          along the way.
        </p>
      </div>

      <PostList posts={posts} showDates />
    </div>
  </section>
</Layout>
